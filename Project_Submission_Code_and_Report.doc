def generate_sales_data(output_file="retail_inventory_data.csv", start_date="2024-01-01", days=730):
    date_range = pd.date_range(start=start_date, periods=days, freq="D")
    records = []
    day_multipliers = {0: 0.88, 1: 0.90, 2: 0.94, 3: 0.98, 4: 1.22, 5: 1.38, 6: 1.25}
    monthly_multipliers = {
        "Electronics": {1: 0.92, 2: 0.90, 3: 0.95, 4: 0.96, 5: 1.00, 6: 1.05, 7: 1.15, 8: 1.02, 9: 1.08, 10: 1.15, 11: 1.45, 12: 1.60},
        "Groceries": {1: 1.02, 2: 0.96, 3: 0.98, 4: 1.00, 5: 1.01, 6: 1.04, 7: 1.06, 8: 1.02, 9: 1.03, 10: 1.08, 11: 1.20, 12: 1.35},
        "Apparel": {1: 0.95, 2: 0.90, 3: 0.96, 4: 1.02, 5: 1.08, 6: 1.12, 7: 1.20, 8: 1.05, 9: 1.00, 10: 1.12, 11: 1.40, 12: 1.55}
    }
    for current_date in date_range:
        weekday = current_date.weekday()
        month = current_date.month
        for p in PRODUCTS_CATALOG:
            cat = p["category"]
            base_demand = p["base_demand"]
            base_price = p["base_price"]
            dow_factor = day_multipliers[weekday]
            month_factor = monthly_multipliers[cat][month]
            promo = 1 if np.random.rand() < 0.13 else 0
            if promo == 1:
                promo_factor = np.random.uniform(1.35, 1.65)
                discount = np.random.uniform(0.10, 0.20)
                actual_price = round(base_price * (1.0 - discount), 2)
            else:
                promo_factor = 1.00
                actual_price = round(base_price * np.random.uniform(0.98, 1.02), 2)
            expected_demand = base_demand * dow_factor * month_factor * promo_factor
            noise = np.random.normal(0, max(2.0, expected_demand * 0.08))
            daily_sales = int(max(0, np.round(expected_demand + noise)))
            revenue = round(daily_sales * actual_price, 2)
            records.append({
                "date": current_date.strftime("%Y-%m-%d"),
                "product_id": p["product_id"],
                "product_name": p["product_name"],
                "category": p["category"],
                "price": actual_price,
                "promotion": promo,
                "sales": daily_sales,
                "revenue": revenue,
                "current_stock": p["current_stock"],
                "lead_time_days": p["lead_time_days"],
                "unit_cost": p["unit_cost"],
                "holding_cost": p["holding_cost"],
                "ordering_cost": p["ordering_cost"]
            })
    df = pd.DataFrame(records)
    df["date"] = pd.to_datetime(df["date"])
    df.to_csv(output_file, index=False)
    return df
</pre>

<h2>7.2 File 2: model.py</h2>
<pre>
"""
model.py - Demand Forecasting Engine using Scikit-Learn RandomForestRegressor
"""
import os
import joblib
import numpy as np
import pandas as pd
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_absolute_error, mean_squared_error

MODEL_FILE = "demand_model.joblib"
DATA_FILE = "retail_inventory_data.csv"
RANDOM_SEED = 42

def create_features(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()
    df["date"] = pd.to_datetime(df["date"])
    df = df.sort_values(["product_id", "date"]).reset_index(drop=True)
    df["day_of_week"] = df["date"].dt.dayofweek
    df["month"] = df["date"].dt.month
    if "product_code" not in df.columns:
        df["product_code"] = df["product_id"].astype("category").cat.codes
    if "category_code" not in df.columns:
        df["category_code"] = df["category"].astype("category").cat.codes
    df["lag_7"] = df.groupby("product_id")["sales"].shift(7)
    df["lag_14"] = df.groupby("product_id")["sales"].shift(14)
    df["rolling_mean_7"] = df.groupby("product_id")["sales"].transform(lambda x: x.shift(1).rolling(7, min_periods=1).mean())
    df["rolling_mean_30"] = df.groupby("product_id")["sales"].transform(lambda x: x.shift(1).rolling(30, min_periods=1).mean())
    return df

def train_demand_model(data_path: str = DATA_FILE, test_days: int = 60, save_path: str = MODEL_FILE):
    df = pd.read_csv(data_path)
    df_feat = create_features(df)
    df_clean = df_feat.dropna(subset=["lag_7", "lag_14", "rolling_mean_7", "rolling_mean_30"]).copy()
    max_date = df_clean["date"].max()
    split_date = max_date - pd.Timedelta(days=test_days)
    train_df = df_clean[df_clean["date"] <= split_date].copy()
    test_df = df_clean[df_clean["date"] > split_date].copy()
    feature_cols = ["product_code", "category_code", "day_of_week", "month", "price", "promotion", "lag_7", "lag_14", "rolling_mean_7", "rolling_mean_30"]
    X_train, y_train = train_df[feature_cols], train_df["sales"]
    X_test, y_test = test_df[feature_cols], test_df["sales"]
    model = RandomForestRegressor(n_estimators=100, max_depth=12, min_samples_split=4, random_state=RANDOM_SEED, n_jobs=-1)
    model.fit(X_train, y_train)
    y_pred = np.maximum(0, np.round(model.predict(X_test)))
    test_df["predicted_sales"] = y_pred
    ml_mae = mean_absolute_error(y_test, y_pred)
    ml_rmse = np.sqrt(mean_squared_error(y_test, y_pred))
    baseline_pred = test_df["rolling_mean_7"].values
    baseline_mae = mean_absolute_error(y_test, baseline_pred)
    baseline_rmse = np.sqrt(mean_squared_error(y_test, baseline_pred))
    payload = {
        "model": model, "feature_cols": feature_cols,
        "product_mapping": dict(zip(df_clean["product_id"], df_clean["product_code"])),
        "category_mapping": dict(zip(df_clean["category"], df_clean["category_code"])),
        "metrics": {"ml_mae": round(ml_mae, 3), "ml_rmse": round(ml_rmse, 3), "baseline_mae": round(baseline_mae, 3), "baseline_rmse": round(baseline_rmse, 3)},
        "test_df": test_df[["date", "product_id", "product_name", "category", "sales", "predicted_sales", "rolling_mean_7"]]
    }
    joblib.dump(payload, save_path)
    return payload
</pre>

<h2>7.3 File 3: inventory_logic.py</h2>
<pre>
"""
inventory_logic.py - Computes Safety Stock, Reorder Point, EOQ, ABC Analysis
"""
import numpy as np
import pandas as pd

def compute_safety_stock(lead_time_days: float, std_daily_demand: float, service_level_z: float = 1.65) -> int:
    ss = service_level_z * np.sqrt(max(1.0, lead_time_days)) * max(1.0, std_daily_demand)
    return int(np.ceil(ss))

def compute_reorder_point(lead_time_days: float, avg_daily_demand: float, safety_stock: int) -> int:
    rop = (lead_time_days * avg_daily_demand) + safety_stock
    return int(np.ceil(rop))

def compute_eoq(annual_demand: float, ordering_cost: float, holding_cost: float) -> int:
    if holding_cost <= 0 or annual_demand <= 0 or ordering_cost <= 0:
        return int(max(1, annual_demand / 12))
    eoq = np.sqrt((2.0 * annual_demand * ordering_cost) / holding_cost)
    return int(np.ceil(eoq))

def perform_abc_analysis(df_inventory: pd.DataFrame) -> pd.DataFrame:
    df = df_inventory.copy()
    df = df.sort_values(by="annual_revenue", ascending=False).reset_index(drop=True)
    total_revenue = df["annual_revenue"].sum()
    df["cum_revenue"] = df["annual_revenue"].cumsum()
    df["cum_revenue_pct"] = (df["cum_revenue"] / total_revenue) * 100.0
    prev_cum = df["cum_revenue_pct"].shift(1).fillna(0)
    classes = []
    for p in prev_cum:
        if p < 70.0: classes.append("A")
        elif p < 90.0: classes.append("B")
        else: classes.append("C")
    df["abc_class"] = classes
    return df
</pre>

